# Rangriti Studio — environment contract.
# Copy to .env.local and fill in. Every value is read and validated by lib/config.ts.
# Anything marked (required) must be set or the server refuses to start that feature
# with a readable error. Nothing here is ever sent to the browser except the two
# values marked (public).

# --- LLM: Google Gemini (server-side only) ---
# (required) API key for @google/genai.
GEMINI_API_KEY=
# (optional, default gemini-3.5-flash-lite) Model id used for extraction.
LLM_MODEL=gemini-3.5-flash-lite

# --- Supabase ---
# (required, public) https://<ref>.supabase.co
PROJECT_URL=
# (required, public) sb_publishable_... — inert by design (RLS on, no policies).
PUBLISHABLE_KEY=
# (required, server only) sb_secret_... — used for ALL DB writes and storage uploads.
SUPABASE_SECRET_KEY=
# (optional) Postgres URI — migrations / SQL only, never read at runtime.
CONNECTION_STRING=
# (optional, default products) Products table name.
SUPABASE_PRODUCTS_TABLE=products
# (optional, default product-images) PUBLIC storage bucket for product images.
SUPABASE_STORAGE_BUCKET=product-images

# --- Admin (single login, id + password) ---
# (required) Login id.
ADMIN_ID=
# (required) Login password.
ADMIN_PASSWORD=
# (required, >= 32 chars) HMAC secret for the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Storefront ---
# (optional) WhatsApp number for customer enquiries, with country code, e.g. +919876543210.
# A bare 10-digit number is assumed Indian (+91). Unset => enquiry buttons are hidden.
WHATSAPP_NUMBER=
